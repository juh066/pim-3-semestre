<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuroraGaleria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AuroraGaleria.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AuroraGaleria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                    <div class="navbar-actions" aria-label="Acessos rapidos">
                        <a class="navbar-icon-button" href="#comprar-ingressos" aria-label="Comprar Ingressos" title="Comprar Ingressos">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                                <path d="M13 5v2" />
                                <path d="M13 17v2" />
                                <path d="M13 11v2" />
                            </svg>
                        </a>
                        <a class="navbar-icon-button" href="#agendar-visita" aria-label="Agendar Visita" title="Agendar Visita">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M8 2v4" />
                                <path d="M16 2v4" />
                                <rect width="18" height="18" x="3" y="4" rx="2" />
                                <path d="M3 10h18" />
                                <path d="M8 14h.01" />
                                <path d="M12 14h.01" />
                                <path d="M16 14h.01" />
                                <path d="M8 18h.01" />
                                <path d="M12 18h.01" />
                            </svg>
                        </a>
                        <a class="navbar-icon-button" href="#lojinha" aria-label="Lojinha" title="Lojinha">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                                <path d="M3 6h18" />
                                <path d="M16 10a4 4 0 0 1-8 0" />
                            </svg>
                        </a>
                        <button id="cartButton" class="navbar-icon-button cart-navbar-button" type="button" aria-label="Abrir carrinho" title="Carrinho">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <circle cx="8" cy="21" r="1" />
                                <circle cx="19" cy="21" r="1" />
                                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
                            </svg>
                            <span id="cartCount" class="cart-count" hidden>0</span>
                        </button>
                        <button id="userProfileIcon" class="navbar-user-button" type="button" data-bs-toggle="modal" data-bs-target="#authModal" aria-label="Abrir login e cadastro" title="Login e Cadastro">
                            <svg id="userIconSvg" aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M19 21a7 7 0 0 0-14 0" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span id="userInitials" class="user-initials" aria-hidden="true"></span>
                            <span id="userName" class="user-name-label"></span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <!-- Notification Container -->
            <div id="notificationContainer" class="notification-container"></div>
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content auth-modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="authModalLabel">Área do usuário</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="auth-modal-grid">
                        <div class="auth-panel">
                            <h3>Login</h3>
                            <form id="loginForm">
                                <input type="email" placeholder="Email" required>
                                <input type="password" placeholder="Senha" required>
                                <button type="submit">Entrar</button>
                            </form>
                        </div>

                        <div class="auth-panel">
                            <h3>Cadastro</h3>
                            <form id="registerForm">
                                <input type="text" placeholder="Nome" required>
                                <input type="text" placeholder="CPF (11 dígitos)" id="cpfInput" maxlength="11" required>
                                <input type="email" placeholder="Email" required>
                                <input type="password" placeholder="Senha" required>
                                <button type="submit">Cadastrar</button>
                            </form>
                        </div>
                    </div>
                    <div id="loggedInActions" class="logged-in-actions" hidden>
                        <div class="account-summary">
                            <span>Você está conectado.</span>
                            <button id="logoutBtn" type="button">Sair</button>
                        </div>
                        <div class="user-records-grid">
                            <section class="user-records-panel" aria-labelledby="userTicketsTitle">
                                <h3 id="userTicketsTitle">Meus Ingressos</h3>
                                <div id="userTicketsList" class="user-records-list"></div>
                                <p id="userTicketsEmpty" class="user-records-empty">Você ainda não comprou ingressos.</p>
                            </section>
                            <section class="user-records-panel" aria-labelledby="userAppointmentsTitle">
                                <h3 id="userAppointmentsTitle">Meus Agendamentos</h3>
                                <div id="userAppointmentsList" class="user-records-list"></div>
                                <p id="userAppointmentsEmpty" class="user-records-empty">Você ainda não tem visitas agendadas.</p>
                            </section>
                            <section class="user-records-panel user-purchases-panel" aria-labelledby="userPurchasesTitle">
                                <h3 id="userPurchasesTitle">Minhas Compras</h3>
                                <div id="userPurchasesList" class="user-records-list"></div>
                                <p id="userPurchasesEmpty" class="user-records-empty">Nenhuma compra realizada.</p>
                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content auth-modal-content payment-modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="paymentModalLabel">Pagamento</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <form id="paymentForm" class="payment-form" novalidate>
                        <div class="payment-field">
                            <div class="card-number-field">
                                <input id="paymentCardNumber" type="text" inputmode="numeric" autocomplete="cc-number" placeholder="Número do cartão" maxlength="19" required>
                                <span id="paymentCardIcon" class="card-type-icon" aria-hidden="true">CARD</span>
                            </div>
                            <p class="payment-error" id="paymentCardNumberError"></p>
                        </div>

                        <div class="payment-field">
                            <input id="paymentCardName" type="text" autocomplete="cc-name" placeholder="Nome impresso no cartão" maxlength="60" required>
                            <p class="payment-error" id="paymentCardNameError"></p>
                        </div>

                        <div class="payment-row">
                            <div class="payment-field">
                                <input id="paymentExpiry" type="text" inputmode="numeric" autocomplete="cc-exp" placeholder="Validade (MM/AA)" maxlength="5" required>
                                <p class="payment-error" id="paymentExpiryError"></p>
                            </div>

                            <div class="payment-field">
                                <input id="paymentCvv" type="text" inputmode="numeric" autocomplete="cc-csc" placeholder="CVV" maxlength="3" required>
                                <p class="payment-error" id="paymentCvvError"></p>
                            </div>
                        </div>

                        <div class="payment-field">
                            <input id="paymentCep" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="CEP" maxlength="9" required>
                            <p class="payment-error" id="paymentCepError"></p>
                        </div>

                        <div class="payment-actions">
                            <button id="paymentConfirmButton" type="submit">Confirmar pagamento</button>
                            <button id="paymentCancelButton" class="payment-cancel-button" type="button" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div id="cartBackdrop" class="cart-backdrop" hidden></div>
    <aside id="cartDrawer" class="cart-drawer" aria-labelledby="cartDrawerTitle" aria-hidden="true">
        <div class="cart-drawer-header">
            <h2 id="cartDrawerTitle">Carrinho</h2>
            <button id="cartCloseButton" class="cart-close-button" type="button" aria-label="Fechar carrinho">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </button>
        </div>
        <div id="cartItems" class="cart-items"></div>
        <p id="cartEmpty" class="cart-empty">Seu carrinho está vazio.</p>
        <div class="cart-drawer-footer">
            <div class="cart-total-row">
                <span>Total</span>
                <strong id="cartTotal">R$ 0,00</strong>
            </div>
            <button id="cartCheckoutButton" type="button" disabled>Finalizar compra</button>
        </div>
    </aside>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- VLibras -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>

</body>
</html>
