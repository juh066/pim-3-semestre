@model List<AuroraGaleria.Models.Exposicao>

@{
    ViewData["Title"] = "Galeria Aurora";
}

<section class="hero">
    <div class="hero-content">
        <h1>GALERIA AURORA</h1>
        <p>Arte contemporânea e experiências imersivas.</p>
        <a href="#exposicoes" class="btn-main">Explorar</a>
    </div>
</section>

<section id="exposicoes" class="section">
    <h2>Exposições</h2>
  <div class="cards">
        @foreach (var expo in Model)
        {
            <div class="card">
                <img src="@expo.ImagemUrl" alt="@expo.Titulo">
                <div class="card-content">
                    <h3>@expo.Titulo</h3>
                    <p>@expo.Descricao</p>
                    <span>@expo.Data</span>
                </div>
            </div>
        }
    </div>
</section>

<section class="tickets">
    <div class="ticket-box">
        <h2>Comprar Ingressos</h2>

        <form id="ticketForm">
            <input type="text" placeholder="Seu nome" required>
            <input type="date" required>
            <input type="number" placeholder="Quantidade" min="1" required>
            <button type="submit">Comprar</button>
        </form>
    </div>
</section>

<section class="agenda">
    <h2>Agendar Visita</h2>

    <form id="agendaForm" class="agenda-form">
        <input type="text" placeholder="Nome" required>
        <input type="email" placeholder="Email" required>
        <input type="date" required>
        <button type="submit">Agendar</button>
    </form>
</section>
<section class="shop">
    <h2>Lojinha</h2>

    <div class="shop-grid">
        <div class="product">
            <img src="/images/caneca.jpg">
            <h3>Caneca Aurora</h3>
            <p>R$ 49,90</p>
            <button type="button">Comprar</button>
        </div>

        <div class="product">
            <img src="/images/totebag.jpg">
            <h3>Tote Bag</h3>
            <p>R$ 69,90</p>
            <button type="button">Comprar</button>
        </div>

        <div class="product">
            <img src="/images/caderno.jpg">
            <h3>Caderno Artístico</h3>
            <p>R$ 39,90</p>
            <button type="button">Comprar</button>
        </div>
    </div>
</section>
<section class="login-section">
    <div class="login-box">
        <h2>Login</h2>

        <form id="loginForm">
            <input type="email" placeholder="Email" required>
            <input type="password" placeholder="Senha" required>
            <button type="submit">Entrar</button>
        </form>
    </div>

    <div class="register-box">
        <h2>Cadastro</h2>

        <form id="registerForm">
            <input type="text" placeholder="Nome" required>
            <input type="text" placeholder="CPF (11 dígitos)" id="cpfInput" maxlength="11" required>
            <input type="email" placeholder="Email" required>
            <input type="password" placeholder="Senha" required>
            <button type="submit">Cadastrar</button>
        </form>
    </div>
</section>

<footer>
    <p>Galeria Aurora © 2026 — Arte contemporânea para todos.</p>
</footer>
